# ---- Server (Render) ----
PORT=3000
NODE_ENV=production

# MongoDB Atlas connection string
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sai_prasad_driving_school?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sai_prasad_driving_school
# JWT — generate a strong secret: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# Business timezone — attendance days are resolved in this zone
BUSINESS_TIMEZONE=Asia/Kolkata

# Global rate limit (requests per minute per IP)
RATE_LIMIT_MAX=200

# ---- Client (Vite) ----
# Local dev:
# VITE_API_URL=http://localhost:3000/api
# Production (set this when building the frontend for Render/Vercel):
# VITE_API_URL=https://sai-prasad-driving-school-api.onrender.com/api
